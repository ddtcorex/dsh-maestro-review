{
  "name": "@ddtcorex/dsh-maestro-review",
  "version": "0.1.0",
  "description": "Maestro Review \u2014 pluggable ReviewProvider (GitLab/GitHub) + orchestrator for automated MR review",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
