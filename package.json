{
  "name": "@ddtcorex/dsh-maestro-review",
  "private": false,
  "version": "0.3.1",
  "description": "Maestro Review — pluggable ReviewProvider (GitLab/GitHub) + orchestrator for automated MR review",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "lib",
    "src",
    "presets",
    "client"
  ],
  "bin": {
    "runner": "lib/runner/cli.js"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.runner.json",
    "test": "vitest run",
    "verify": "tsc --noEmit && tsc -p tsconfig.runner.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6 || >=0.1.1-rc.0 <0.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.0.0",
    "@ddtcorex/dsh-maestro-config-lib": "workspace:^0.1.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "typescript": "^5.8.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-title": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@11.7.0"
}
